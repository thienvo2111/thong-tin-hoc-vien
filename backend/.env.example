DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thong_tin_hoc_vien?schema=public"
PORT=3000
# Dia chi backend nghe. Mac dinh 127.0.0.1 (Nginx proxy noi bo).
# HOST=127.0.0.1
# Swagger UI tai /api: mac dinh bat o dev, TAT khi NODE_ENV=production.
# SWAGGER_ENABLED=true

# Danh sách origin FE được phép gọi API (CORS), phân cách bởi dấu phẩy. Để
# trống thì dev/test (NODE_ENV khác 'production') cho phép mọi origin; nếu
# NODE_ENV=production mà để trống thì KHÔNG origin nào được phép (chặn hẳn,
# tránh mặc định mở toang) — phải đặt rõ danh sách khi deploy thật.
CORS_ORIGIN=http://localhost:5173

# Dùng để dựng link trong email xác minh email liên hệ / đặt lại mật khẩu
# (2026-09-30, xem backend/src/common/utils/token-xac-thuc.util.ts) — KHÔNG
# gồm dấu / ở cuối. Mặc định trùng CORS_ORIGIN dev nếu để trống.
FRONTEND_URL=http://localhost:5173

# Bí mật ký JWT — BẮT BUỘC đặt giá trị riêng, đủ dài/ngẫu nhiên khi deploy
# thật. Auth module chỉ dùng giá trị mặc định không an toàn khi thiếu biến
# này để không chặn chạy dev cục bộ.
JWT_SECRET=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-du-dai
JWT_EXPIRES_IN=8h

# Dùng bởi prisma/seed.ts để tạo tài khoản quan_tri đầu tiên cho dev/test cục
# bộ (chưa có luồng cấp tài khoản Sở/Phòng/Trường/QuảnTrị nào khác). Nếu để
# trống, script tự sinh mật khẩu ngẫu nhiên và in ra console — không hardcode
# mật khẩu thật trong code.
SEED_QUAN_TRI_TEN_DANG_NHAP=quantri@thongtinhocvien.local
SEED_QUAN_TRI_MAT_KHAU=

# Dịch vụ Thông báo (docs/api-contract.md mục 8) — gửi email qua nodemailer.
# Để trống SMTP_HOST (mặc định) thì dev/test cục bộ tự tạo 1 tài khoản
# Ethereal (https://ethereal.email) mỗi lần khởi động app — email không đến
# hộp thư thật, nhưng gửi/nhận được thật qua giao thức SMTP, và mỗi lần gửi
# đều in ra console 1 preview URL để xem lại nội dung email. Điền các biến
# dưới đây để chuyển sang SMTP provider thật (Gmail/SES/SendGrid/...) khi
# triển khai — không cần sửa code.
#
# Giá trị cho Google Workspace (boiduongnls@hcmue.edu.vn, 2026-10-01):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=boiduongnls@hcmue.edu.vn
#   SMTP_PASS=<App Password — tạo ở Google Account > Security > App passwords,
#     KHÔNG dùng mật khẩu đăng nhập thường, tài khoản phải bật 2FA trước>
#   SMTP_FROM=boiduongnls@hcmue.edu.vn
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# M9 (2026-10-01): hạn mức số email thực sự gửi (trang_thai=thanh_cong)
# trong 1 ngày (tính theo giờ Việt Nam) — HangDoiEmailProcessor (cron mỗi
# phút, thong-bao module) dùng để trải việc gửi hàng loạt (phân lớp, duyệt
# hồ sơ, ...) qua nhiều ngày, tránh gửi dồn dập khiến Google tạm khóa/
# quarantine tài khoản Workspace. Tự đặt THẤP HƠN hạn mức thật của Google
# (thường 2000-10000/ngày tùy có SMTP relay hay không) để có biên an toàn —
# nâng số này qua biến môi trường khi IT HCMUE bật SMTP relay, không cần sửa
# code. Để trống thì dùng mặc định 2000.
EMAIL_DAILY_LIMIT=2000

# T15 (mo-rong-nls-an-giang.md) — khóa mã hóa mat_khau_tam (tài khoản VLE
# tạm) bằng AES-256-GCM ở tầng ứng dụng (vle-crypto.util.ts). Chuỗi bất kỳ,
# độ dài tùy ý (được băm SHA-256 để ra đúng 32 byte) — BẮT BUỘC đặt giá trị
# riêng, đủ dài/ngẫu nhiên khi deploy thật. Để trống thì dùng giá trị mặc
# định không an toàn (chỉ để không chặn chạy dev cục bộ).
VLE_SECRET_KEY=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-du-dai

# SSO sang hệ thống khảo sát (2026-10-02, docs/api-contract.md mục 10).
# Cổng cấp mã dùng 1 lần rồi chuyển học viên tới SSO_KHAO_SAT_URL?code=..&target=..
# Để trống URL -> mặc định https://khaosatnls.hcmue.edu.vn/sso/start.
# SSO_KHAO_SAT_API_KEY: khóa bí mật DÙNG CHUNG với máy chủ khảo sát (gửi qua header
# X-API-Key khi gọi POST /sso/doi-ma). Để trống -> /sso/doi-ma trả 503 (tắt hẳn đổi mã).
# Sinh khóa: openssl rand -base64 48 | tr -dc 'A-Za-z0-9'
SSO_KHAO_SAT_URL=
SSO_KHAO_SAT_API_KEY=
