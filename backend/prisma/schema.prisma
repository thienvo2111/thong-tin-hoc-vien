// Prisma schema — dịch từ docs/database-ddl.sql (nguồn sự thật cho data model).
// Đặt tên model/field trùng chính xác tên bảng/cột trong DDL (snake_case) để
// tránh sai lệch khi đối chiếu — không dùng @@map/@map.
//
// CHECK constraints, GIN trgm indexes, extension pgcrypto/pg_trgm và 2 trigger
// (trg_dang_ky_lop_thuoc_khoa, trg_set_updated_at) KHÔNG biểu diễn được bằng
// Prisma schema DSL — được thêm bằng raw SQL nối vào migration khởi tạo, xem
// prisma/migrations/*/migration.sql (phần "-- Raw SQL bổ sung ...").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

