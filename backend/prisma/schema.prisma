// =====================================================================
// PHẦN 1 — DANH MỤC DÙNG CHUNG
// =====================================================================

model nhat_ky_import {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loai_danh_muc      loai_danh_muc_import
  ten_file_goc       String               @db.VarChar(255)
  nguoi_import_id    String               @db.Uuid
  thoi_gian_import   DateTime             @default(now()) @db.Timestamptz(6)
  tong_so_dong       Int                  @default(0)
  so_dong_thanh_cong Int                  @default(0)
  so_dong_loi        Int                  @default(0)
  file_loi_url       String?
  trang_thai         trang_thai_import    @default(dang_xu_ly)

  nguoi_import             nguoi_dung          @relation("nhat_ky_import_nguoi_import", fields: [nguoi_import_id], references: [id], map: "fk_import_nguoi_import", onDelete: NoAction, onUpdate: NoAction)
  dia_danh_import          dia_danh[]
  don_vi_import            don_vi_cong_tac[]
  mon_hoc_import           mon_hoc[]
  tai_khoan_vle_import     tai_khoan_vle[]
  diem_danh_import         diem_danh[]
  ket_qua_giai_doan_import ket_qua_giai_doan[]

  @@index([nguoi_import_id], map: "idx_import_nguoi")
  @@index([loai_danh_muc], map: "idx_import_loai")
}

model dia_danh {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma              String             @unique(map: "uq_dia_danh_ma") @db.VarChar(20)
  ten             String             @db.VarChar(255)
  cap             cap_dia_danh
  parent_id       String?            @db.Uuid
  trang_thai      trang_thai_active  @default(active)
  // Thêm 2026-09-30: hien_tai (mặc định) / lich_su (mã cũ trước sáp nhập,
  // giữ để lưu đúng lịch sử công tác) / dac_biet (placeholder, không phải
  // địa giới thật).
  phien_ban       phien_ban_dia_danh @default(hien_tai)
  nguon_import_id String?            @db.Uuid
  created_at      DateTime           @default(now()) @db.Timestamptz(6)
  updated_at      DateTime           @default(now()) @db.Timestamptz(6)

  parent   dia_danh?  @relation("dia_danh_hierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children dia_danh[] @relation("dia_danh_hierarchy")

  nguon_import nhat_ky_import? @relation(fields: [nguon_import_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  don_vi_cong_tac           don_vi_cong_tac[]
  hoc_vien_noi_sinh         hoc_vien[]        @relation("hoc_vien_noi_sinh")
  hoc_vien_phuong_xa        hoc_vien[]        @relation("hoc_vien_phuong_xa")
  // Thêm 2026-09-30: "Cư trú" — dùng địa giới hành chính HIỆN TẠI (khác
  // noi_sinh/phuong_xa ở trên vốn là nơi sinh theo địa giới có thể đã cũ).
  hoc_vien_cu_tru_tinh      hoc_vien[]        @relation("hoc_vien_cu_tru_tinh")
  hoc_vien_cu_tru_phuong_xa hoc_vien[]        @relation("hoc_vien_cu_tru_phuong_xa")

  @@index([parent_id], map: "idx_dia_danh_parent")
  @@index([cap], map: "idx_dia_danh_cap")
}

model don_vi_cong_tac {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_don_vi       String?           @unique(map: "uq_don_vi_ma") @db.VarChar(30)
  ten_don_vi      String            @db.VarChar(255)
  loai_don_vi     loai_don_vi
  dia_ban_id      String            @db.Uuid
  don_vi_cha_id   String?           @db.Uuid
  trang_thai      trang_thai_active @default(active)
  nguon_import_id String?           @db.Uuid
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)

  dia_ban      dia_danh          @relation(fields: [dia_ban_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  don_vi_cha   don_vi_cong_tac?  @relation("don_vi_cong_tac_cha", fields: [don_vi_cha_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  don_vi_con   don_vi_cong_tac[] @relation("don_vi_cong_tac_cha")
  nguon_import nhat_ky_import?   @relation(fields: [nguon_import_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  nguoi_dung     nguoi_dung[]
  hoc_vien       hoc_vien[]
  khoa_boi_duong khoa_boi_duong[]
  khoa_theo_doi  khoa_don_vi_theo_doi[]

  @@index([loai_don_vi], map: "idx_don_vi_loai")
  @@index([dia_ban_id], map: "idx_don_vi_dia_ban")
  @@index([don_vi_cha_id], map: "idx_don_vi_cha")
}

model mon_hoc {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ten_mon         String            @db.VarChar(255)
  cap_hoc         cap_hoc
  trang_thai      trang_thai_active @default(active)
  nguon_import_id String?           @db.Uuid
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)

  nguon_import nhat_ky_import? @relation(fields: [nguon_import_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hoc_vien     hoc_vien[]

  @@unique([ten_mon, cap_hoc], map: "uq_mon_hoc")
  @@index([cap_hoc], map: "idx_mon_hoc_cap")
}

// ---------------------------------------------------------------------
// NguoiDung — hoc_vien_id trỏ tới hoc_vien(id); cùng với hoc_vien.created_by
// / hoc_vien.nguoi_duyet_id trỏ ngược lại nguoi_dung(id), đây là phụ thuộc
// vòng giữa 2 bảng giống hệt DDL gốc (DDL dùng ALTER TABLE ADD CONSTRAINT
// sau khi cả 2 bảng tồn tại) — Prisma tự xử lý thứ tự tạo bảng/FK.
// ---------------------------------------------------------------------
model nguoi_dung {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ho_ten               String             @db.VarChar(255)
  email                String?            @unique(map: "uq_nguoi_dung_email") @db.VarChar(255)
  ten_dang_nhap        String             @unique(map: "uq_nguoi_dung_ten_dang_nhap") @db.VarChar(50)
  vai_tro              vai_tro_nguoi_dung
  don_vi_id            String?            @db.Uuid
  hoc_vien_id          String?            @unique(map: "uq_nguoi_dung_hoc_vien") @db.Uuid
  mat_khau_hash        String             @db.VarChar(255)
  phai_doi_mat_khau    Boolean            @default(true)
  trang_thai           trang_thai_active  @default(active)
  // Thêm 2026-09-28 (T1 bảo mật đăng nhập): đếm số lần sai liên tiếp, khóa
  // tạm 15 phút sau 5 lần sai — xem AuthService.dangNhap.
  so_lan_dang_nhap_sai Int                @default(0) @db.SmallInt
  khoa_den             DateTime?          @db.Timestamptz(6)
  // Dùng cho báo cáo "chưa đăng nhập" (T14) — cập nhật mỗi lần đăng nhập thành công.
  dang_nhap_lan_cuoi   DateTime?          @db.Timestamptz(6)
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime           @default(now()) @db.Timestamptz(6)

  don_vi   don_vi_cong_tac? @relation(fields: [don_vi_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hoc_vien hoc_vien?        @relation("nguoi_dung_hoc_vien", fields: [hoc_vien_id], references: [id], map: "fk_nguoi_dung_hoc_vien", onDelete: NoAction, onUpdate: NoAction)

  nhat_ky_import                     nhat_ky_import[]           @relation("nhat_ky_import_nguoi_import")
  hoc_vien_nguoi_duyet               hoc_vien[]                 @relation("hoc_vien_nguoi_duyet")
  hoc_vien_created_by                hoc_vien[]                 @relation("hoc_vien_created_by")
  khoa_boi_duong_duyet               khoa_boi_duong[]           @relation("khoa_boi_duong_nguoi_duyet")
  khoa_boi_duong_created_by          khoa_boi_duong[]           @relation("khoa_boi_duong_created_by")
  token_thu_hoi                      token_thu_hoi[]
  nhat_ky_dat_lai_mat_khau_cua_toi   nhat_ky_dat_lai_mat_khau[] @relation("nhat_ky_dlmk_nguoi_dung")
  nhat_ky_dat_lai_mat_khau_thuc_hien nhat_ky_dat_lai_mat_khau[] @relation("nhat_ky_dlmk_thuc_hien_boi")
  dot_xac_nhan_created_by            dot_xac_nhan[]             @relation("dot_xac_nhan_created_by")
  lich_su_thay_doi_thuc_hien         lich_su_thay_doi_ho_so[]   @relation("lich_su_thay_doi_nguoi_sua")
  yeu_cau_ho_tro_tra_loi_boi         yeu_cau_ho_tro[]           @relation("yeu_cau_ho_tro_tra_loi_boi")

  @@index([vai_tro], map: "idx_nguoi_dung_vai_tro")
  @@index([don_vi_id], map: "idx_nguoi_dung_don_vi")
}

// Thêm 2026-09-28: cơ chế thu hồi token cho POST /auth/dang-xuat (JWT vốn
// stateless — xem docs/database-ddl.sql comment tại đây). PK = jti, tra cứu
// trên mọi request đã xác thực (JwtAuthGuard) nên cần rẻ (PK lookup).
model token_thu_hoi {
  jti           String   @id @db.Uuid
  nguoi_dung_id String   @db.Uuid
  het_han       DateTime @db.Timestamptz(6)
  thu_hoi_luc   DateTime @default(now()) @db.Timestamptz(6)

  nguoi_dung nguoi_dung @relation(fields: [nguoi_dung_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([nguoi_dung_id], map: "idx_token_thu_hoi_nguoi_dung")
  @@index([het_han], map: "idx_token_thu_hoi_het_han")
}

// T1 (bảo mật đăng nhập, 2026-09-28): nhật ký cho POST
// /nguoi-dung/{id}/dat-lai-mat-khau — ai đặt lại mật khẩu cho ai, lúc nào.
// Không có bảng/spec sẵn cho việc này trong mo-rong-nls-an-giang.md (chỉ nói
// "ghi nhật ký"), nên bảng này là tối thiểu tự thêm — flagged trong self-review.
model nhat_ky_dat_lai_mat_khau {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nguoi_dung_id String   @db.Uuid
  thuc_hien_boi String   @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  nguoi_dung nguoi_dung @relation("nhat_ky_dlmk_nguoi_dung", fields: [nguoi_dung_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  thuc_hien  nguoi_dung @relation("nhat_ky_dlmk_thuc_hien_boi", fields: [thuc_hien_boi], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([nguoi_dung_id], map: "idx_nhat_ky_dlmk_nguoi_dung")
}

// =====================================================================
// PHẦN 2 — HỒ SƠ HỌC VIÊN
// =====================================================================

model hoc_vien {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nguon_tao nguon_tao_ho_so @default(tu_dang_ky)

  ho_ten               String  @db.VarChar(255)
  so_dinh_danh_ca_nhan String? @unique(map: "uq_hoc_vien_ddcn") @db.Char(12)
  ma_dinh_danh_moet    String? @unique(map: "uq_hoc_vien_ma_moet") @db.VarChar(20)
  ngay_sinh            Int     @db.SmallInt
  thang_sinh           Int     @db.SmallInt
  nam_sinh             Int     @db.SmallInt
  gioi_tinh            String? @db.VarChar(20)
  chuc_vu              String? @db.VarChar(100)

  // Deprecated 2026-09-30: thay bởi "noi_sinh" (text tự do, xem bên dưới) —
  // GIỮ NGUYÊN cột/quan hệ này để không mất dữ liệu cũ, không còn dùng trong
  // luồng nghiệp vụ mới (validate/DTO/service đã ngừng đọc-ghi qua field này,
  // trừ dữ liệu lịch sử đã có sẵn trước 2026-09-30).
  noi_sinh_id  String? @db.Uuid
  phuong_xa_id String? @db.Uuid

  // T17 (2026-10-01): tách "noi_sinh" (1 ô text tự do, thêm 2026-09-30) thành
  // 3 trường Tỉnh/Huyện/Xã riêng biệt theo yêu cầu thực tế — vẫn TEXT TỰ DO,
  // không FK (giấy khai sinh có thể ghi theo địa giới hành chính CŨ, khác
  // địa giới HIỆN TẠI mà dia_danh quản lý). Cột "noi_sinh" cũ đã bị xoá —
  // tại thời điểm tách chỉ có 21/7654 hồ sơ có dữ liệu, toàn bộ là dữ liệu
  // test (xem báo cáo T17), không cần giữ deprecated.
  noi_sinh_tinh  String? @db.VarChar(255)
  noi_sinh_huyen String? @db.VarChar(255)
  noi_sinh_xa    String? @db.VarChar(255)

  // Thêm 2026-09-30: "Cư trú" — TÙY CHỌN, dùng đúng địa giới hành chính HIỆN
  // TẠI (dia_danh đang có), khác nơi sinh (có thể ghi theo địa giới cũ).
  cu_tru_tinh_id      String? @db.Uuid
  cu_tru_phuong_xa_id String? @db.Uuid

  don_vi_cong_tac_id String @db.Uuid

  so_dien_thoai_lien_he String? @db.VarChar(20)
  email_lien_he         String? @db.VarChar(255)
  // Thêm 2026-09-30: xác minh email liên hệ — mặc định false lúc tạo hồ sơ;
  // đổi email_lien_he (PATCH /hoc-vien/toi hoặc PATCH /hoc-vien/{id}) tự
  // reset về false và gửi lại email xác minh (xem HocVienService.suaHoSo +
  // token_xac_thuc). Quên mật khẩu (POST /auth/quen-mat-khau) chỉ gửi link
  // đặt lại khi cột này = true.
  email_da_xac_minh     Boolean @default(false)

  trinh_do_chuyen_mon      trinh_do_chuyen_mon?
  trinh_do_chuyen_mon_khac String?              @db.VarChar(255)
  cap_giang_day            cap_hoc?
  mon_giang_day_id         String?              @db.Uuid

  ghi_chu String?

  trang_thai        trang_thai_ho_so    @default(nhap)
  nguoi_duyet_id    String?             @db.Uuid
  cap_duyet_thuc_te vai_tro_nguoi_dung?
  ngay_duyet        DateTime?           @db.Timestamptz(6)

  email_ban_sao_da_gui_at DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  created_by String?  @db.Uuid

  noi_sinh_dia_danh dia_danh?       @relation("hoc_vien_noi_sinh", fields: [noi_sinh_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  phuong_xa         dia_danh?       @relation("hoc_vien_phuong_xa", fields: [phuong_xa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cu_tru_tinh       dia_danh?       @relation("hoc_vien_cu_tru_tinh", fields: [cu_tru_tinh_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cu_tru_phuong_xa  dia_danh?       @relation("hoc_vien_cu_tru_phuong_xa", fields: [cu_tru_phuong_xa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  don_vi_cong_tac   don_vi_cong_tac @relation(fields: [don_vi_cong_tac_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mon_giang_day     mon_hoc?        @relation(fields: [mon_giang_day_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nguoi_duyet       nguoi_dung?     @relation("hoc_vien_nguoi_duyet", fields: [nguoi_duyet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by_user   nguoi_dung?     @relation("hoc_vien_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  nguoi_dung_account nguoi_dung?              @relation("nguoi_dung_hoc_vien")
  chuyen_mon         hoc_vien_chuyen_mon[]
  dang_ky_hoc        dang_ky_hoc[]
  nhat_ky_thong_bao  nhat_ky_thong_bao[]
  hang_doi_email     hang_doi_email[]
  xac_nhan_ho_so     xac_nhan_ho_so[]
  yeu_cau_ho_tro     yeu_cau_ho_tro[]
  lich_su_thay_doi   lich_su_thay_doi_ho_so[]
  tai_khoan_vle      tai_khoan_vle?

  token_xac_thuc token_xac_thuc[]

  @@index([don_vi_cong_tac_id], map: "idx_hoc_vien_don_vi")
  @@index([trang_thai], map: "idx_hoc_vien_trang_thai")
  @@index([cap_giang_day], map: "idx_hoc_vien_cap_giang_day")
  @@index([phuong_xa_id], map: "idx_hoc_vien_phuong_xa")
  @@index([ma_dinh_danh_moet], map: "idx_hoc_vien_ma_moet")
}

// Thêm 2026-09-30: token dùng 1 lần cho xác minh email liên hệ & quên/đặt lại
// mật khẩu — KHÔNG dùng JWT (không thu hồi được sớm, xem token_thu_hoi ở
// trên cho lý do tương tự với token đăng nhập). token_hash = SHA-256 hex của
// token gốc (chỉ token gốc nằm trong email gửi đi, DB không bao giờ lưu bản
// rõ) — tra theo token_hash (UNIQUE) khi xác thực, không cần hoc_vien_id.
model token_xac_thuc {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hoc_vien_id String              @db.Uuid
  loai        loai_token_xac_thuc
  token_hash  String              @unique(map: "uq_token_xac_thuc_hash") @db.VarChar(64)
  het_han_luc DateTime            @db.Timestamptz(6)
  da_dung_luc DateTime?           @db.Timestamptz(6)
  tao_luc     DateTime            @default(now()) @db.Timestamptz(6)

  hoc_vien hoc_vien @relation(fields: [hoc_vien_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([hoc_vien_id], map: "idx_token_xac_thuc_hoc_vien")
}

model hoc_vien_chuyen_mon {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hoc_vien_id String @db.Uuid
  chuyen_mon  String @db.VarChar(255)

  hoc_vien hoc_vien @relation(fields: [hoc_vien_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([hoc_vien_id, chuyen_mon], map: "uq_hoc_vien_chuyen_mon")
  @@index([hoc_vien_id], map: "idx_hoc_vien_chuyen_mon_hv")
}

// ---------------------------------------------------------------------
// T14 (mo-rong-nls-an-giang.md, 2026-09-28): đợt xác nhận & lịch sử thay
// đổi hồ sơ cho học viên nguon_tao='import_moet'. khoa_id NULL = áp dụng
// mọi hồ sơ import_moet (quyết định "rút gọn để kịp P0", mục 3 của tài
// liệu) — gắn khóa cụ thể để sau này nếu cần, chưa dùng ở lượt này.
//
// CHECK constraints KHÔNG biểu diễn được bằng Prisma DSL (chk_dot_xac_nhan_
// thoi_gian, chk_xac_nhan_hieu_luc) + unique index có điều kiện WHERE
// (uq_xac_nhan_con_hieu_luc) + index có điều kiện WHERE (idx_lich_su_goc_moet)
// — thêm bằng raw SQL nối vào migration, cùng cách làm với migration khởi
// tạo (xem comment đầu file).
// ---------------------------------------------------------------------
model dot_xac_nhan {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  khoa_id    String?           @db.Uuid
  ten        String            @db.VarChar(255)
  loai       loai_dot_xac_nhan
  mo_luc     DateTime          @db.Timestamptz(6)
  dong_luc   DateTime          @db.Timestamptz(6)
  created_by String?           @db.Uuid
  created_at DateTime          @default(now()) @db.Timestamptz(6)

  khoa            khoa_boi_duong? @relation(fields: [khoa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by_user nguoi_dung?     @relation("dot_xac_nhan_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  xac_nhan xac_nhan_ho_so[]
  lich_su  lich_su_thay_doi_ho_so[]

  @@index([khoa_id], map: "idx_dot_xac_nhan_khoa")
}

model xac_nhan_ho_so {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dot_id          String    @db.Uuid
  hoc_vien_id     String    @db.Uuid
  xac_nhan_luc    DateTime  @default(now()) @db.Timestamptz(6)
  du_lieu         Json
  con_hieu_luc    Boolean   @default(true)
  vo_hieu_luc_luc DateTime? @db.Timestamptz(6)

  dot      dot_xac_nhan @relation(fields: [dot_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  hoc_vien hoc_vien     @relation(fields: [hoc_vien_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hoc_vien_id], map: "idx_xac_nhan_hv")
  @@index([dot_id], map: "idx_xac_nhan_dot")
}

model lich_su_thay_doi_ho_so {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hoc_vien_id        String             @db.Uuid
  truong             String             @db.VarChar(64)
  gia_tri_cu         String?
  gia_tri_moi        String?
  la_truong_goc_moet Boolean            @default(false)
  nguoi_sua_id       String             @db.Uuid
  vai_tro_nguoi_sua  vai_tro_nguoi_dung
  dot_id             String?            @db.Uuid
  sua_luc            DateTime           @default(now()) @db.Timestamptz(6)

  hoc_vien  hoc_vien      @relation(fields: [hoc_vien_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nguoi_sua nguoi_dung    @relation("lich_su_thay_doi_nguoi_sua", fields: [nguoi_sua_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dot       dot_xac_nhan? @relation(fields: [dot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hoc_vien_id], map: "idx_lich_su_hv")
}

// T15 (mo-rong-nls-an-giang.md, 2026-09-28): tài khoản VLE do Phòng CNTT tạo
// cho TẤT CẢ học viên import_moet (cách B, QĐ8) — hệ thống chỉ ẩn/hiện
// thông tin này ở GET /hoc-vien/toi/danh-gia-dau-vao tùy điều kiện, không
// chặn tạo tài khoản. mat_khau_tam_ma_hoa mã hóa AES-256-GCM ở tầng ứng
// dụng (VleCryptoUtil, khóa VLE_SECRET_KEY) — KHÔNG BAO GIỜ lưu dạng rõ.
model tai_khoan_vle {
  hoc_vien_id         String    @id @db.Uuid
  ten_dang_nhap_vle   String    @db.VarChar(100)
  mat_khau_tam_ma_hoa Bytes?
  duong_dan           String    @db.VarChar(500)
  lan_dau_xem_luc     DateTime? @db.Timestamptz(6)
  nguon_import_id     String?   @db.Uuid
  cap_nhat_luc        DateTime  @default(now()) @db.Timestamptz(6)

  hoc_vien     hoc_vien        @relation(fields: [hoc_vien_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nguon_import nhat_ky_import? @relation(fields: [nguon_import_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// =====================================================================
// PHẦN 3 — KHÓA BỒI DƯỠNG & LỚP HỌC
// =====================================================================

model khoa_boi_duong {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ma_khoa            String              @unique(map: "uq_khoa_ma") @db.VarChar(30)
  ten_khoa           String              @db.VarChar(255)
  don_vi_to_chuc_id  String              @db.Uuid
  dia_diem           String?             @db.VarChar(255)
  thoi_gian_bat_dau  DateTime            @db.Date
  thoi_gian_ket_thuc DateTime            @db.Date
  trang_thai         trang_thai_khoa     @default(nhap)
  nguoi_duyet_id     String?             @db.Uuid
  cap_duyet_thuc_te  vai_tro_nguoi_dung?
  ngay_duyet         DateTime?           @db.Timestamptz(6)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @db.Timestamptz(6)
  created_by         String?             @db.Uuid
  // Thêm 2026-09-28: tài khoản đã gọi POST /khoa-boi-duong lúc tạo khóa —
  // NULL cho khóa tạo trước migration này (không truy ngược được), xem
  // docs/database-ddl.sql comment tại đây.

  don_vi_to_chuc  don_vi_cong_tac @relation(fields: [don_vi_to_chuc_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nguoi_duyet     nguoi_dung?     @relation("khoa_boi_duong_nguoi_duyet", fields: [nguoi_duyet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by_user nguoi_dung?     @relation("khoa_boi_duong_created_by", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  giai_doan       giai_doan_khoa[]
  lop_hoc         lop_hoc[]
  dang_ky_hoc     dang_ky_hoc[]
  dot_xac_nhan    dot_xac_nhan[]
  don_vi_theo_doi khoa_don_vi_theo_doi[]
  // QĐ10: cụm học viên (nhóm Zalo hỗ trợ theo địa lý) — độc lập với cây đơn
  // vị công tác, thuộc trực tiếp về khóa.
  cum_hoc_vien    cum_hoc_vien[]

  @@index([don_vi_to_chuc_id], map: "idx_khoa_don_vi")
  @@index([trang_thai], map: "idx_khoa_trang_thai")
}

// T2 (mo-rong-nls-an-giang.md, QĐ2, 2026-09-29): đơn vị "theo dõi" một khóa
// do Quản trị tạo cho đơn vị loại 'khac' (HCMUE — không thuộc cây đơn vị An
// Giang). Sở/Phòng VHXH/Trường xem được khóa (metadata/giai đoạn/lớp/lịch)
// nếu đơn vị của họ là chính đơn vị theo dõi hoặc nằm dưới nó trong cây
// don_vi_cha_id (xem ScopeService.getKhoaIdsTheoDoi) — dữ liệu cấp học viên
// (dang_ky_hoc, kết quả) KHÔNG mở rộng theo bảng này, vẫn lọc theo phạm vi
// hồ sơ hiện có (don_vi_cong_tac_id của hoc_vien).
model khoa_don_vi_theo_doi {
  khoa_id   String @db.Uuid
  don_vi_id String @db.Uuid

  khoa   khoa_boi_duong  @relation(fields: [khoa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  don_vi don_vi_cong_tac @relation(fields: [don_vi_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([khoa_id, don_vi_id])
  @@index([don_vi_id], map: "idx_khoa_theo_doi_don_vi")
}

model giai_doan_khoa {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  khoa_id            String              @db.Uuid
  thu_tu             Int
  ten_giai_doan      String              @db.VarChar(255)
  hinh_thuc          hinh_thuc_giai_doan
  thoi_gian_bat_dau  DateTime            @db.Date
  thoi_gian_ket_thuc DateTime            @db.Date
  trang_thai         trang_thai_active   @default(active)
  // Phân lớp theo giai đoạn (spec 2026-10-02): thông tin chung cho giai đoạn
  // không gán lớp (vd đánh giá đầu vào/đầu ra) — hiện cho toàn khóa ở M7.
  link_hoac_dia_diem String?             @db.VarChar(500)
  huong_dan          String?

  khoa              khoa_boi_duong       @relation(fields: [khoa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lich_hoc          lich_hoc_lop[]
  phan_lop          phan_lop_giai_doan[]
  // T12 (mo-rong-nls-an-giang.md, 2026-09-30): tiến độ/kết quả từng giai
  // đoạn, nhập qua import ket_qua_giai_doan.
  ket_qua_giai_doan ket_qua_giai_doan[]

  @@unique([khoa_id, thu_tu], map: "uq_giai_doan_thu_tu")
  @@index([khoa_id], map: "idx_giai_doan_khoa")
}

model lop_hoc {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  khoa_id       String            @db.Uuid
  // QĐ10 (mo-rong-nls-an-giang.md, 2026-09-30): loại lớp — 3 loại ĐỘC LẬP
  // nhau (không phải lớp cha/con). Backfill dữ liệu cũ = 'truc_tiep' (an
  // toàn nhất — dữ liệu trước QĐ10 đều là lớp dùng chung), xem migration
  // thêm cột này (2 bước: thêm cột nullable, backfill, rồi mới SET NOT NULL).
  loai_lop      loai_lop_hoc
  ten_lop       String            @db.VarChar(255)
  si_so_toi_da  Int?
  trang_thai    trang_thai_active @default(active)
  // T6 (mo-rong-nls-an-giang.md, 2026-09-29, QĐ3/QĐ4): nhóm học viên (1-20,
  // 3 nhóm gối đầu) và mức năng lực mục tiêu của lớp — cả 2 nullable (không
  // phải lớp nào cũng cần phân nhóm/mức, vd lớp hỗn hợp trình độ). Nhập qua
  // import lop_va_lich_hoc (T6). chk_lop_hoc_nhom (1-20) không biểu diễn
  // được bằng Prisma DSL — thêm bằng raw SQL nối vào migration B, cùng cách
  // làm với các CHECK constraint khác (xem comment đầu file).
  nhom_hoc_vien Int?              @db.SmallInt
  muc_nang_luc  muc_nang_luc?

  khoa khoa_boi_duong @relation(fields: [khoa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  lich_hoc           lich_hoc_lop[]
  nhan_su            lop_hoc_nhan_su[]
  phan_lop_giai_doan phan_lop_giai_doan[]

  // QĐ10: UNIQUE đổi từ (khoa_id, ten_lop) sang (khoa_id, loai_lop, ten_lop)
  // — cho phép trùng tên lớp GIỮA các loại lớp khác nhau trong cùng khóa
  // (vd "Lớp 1" vừa có ở trực tiếp vừa có ở zoom).
  @@unique([khoa_id, loai_lop, ten_lop], map: "uq_lop_ten_trong_khoa")
  @@index([khoa_id], map: "idx_lop_khoa")
}

// QĐ10 (mo-rong-nls-an-giang.md, 2026-09-30): cụm học viên — nhóm Zalo hỗ
// trợ theo địa lý, KHÁI NIỆM MỚI hoàn toàn, độc lập với cây đơn vị công tác
// VÀ độc lập với 3 loại lớp. Chứa HỌC VIÊN TRỰC TIẾP (dang_ky_hoc.cum_id),
// không qua trung gian lớp nào.
model cum_hoc_vien {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  khoa_id    String            @db.Uuid
  ten_cum    String            @db.VarChar(255)
  link_zalo  String?           @db.VarChar(500)
  ghi_chu    String?
  trang_thai trang_thai_active @default(active)
  created_at DateTime          @default(now()) @db.Timestamptz(6)

  khoa        khoa_boi_duong @relation(fields: [khoa_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dang_ky_hoc dang_ky_hoc[]

  @@unique([khoa_id, ten_cum], map: "uq_cum_ten_trong_khoa")
  @@index([khoa_id], map: "idx_cum_khoa")
}

model lich_hoc_lop {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lop_id             String              @db.Uuid
  giai_doan_id       String              @db.Uuid
  // T6 (mo-rong-nls-an-giang.md, 2026-09-29, QĐ3): 1 lớp có NHIỀU buổi trong
  // cùng 1 giai đoạn (Zoom nhiều buổi; trực tiếp 3 ngày = 3 buổi) — trước đó
  // uq_lich_hoc_lop_giai_doan chỉ cho 1 lịch/giai đoạn, đã bỏ (migration B),
  // thay bằng uq_lich_hoc_lop_giai_doan_buoi (lop_id, giai_doan_id, buoi_so).
  buoi_so            Int                 @default(1) @db.SmallInt
  thoi_gian_bat_dau  DateTime            @db.Timestamptz(6)
  thoi_gian_ket_thuc DateTime            @db.Timestamptz(6)
  dia_diem_hoac_link String?             @db.VarChar(500)
  trang_thai         trang_thai_lich_hoc @default(chua_dien_ra)

  lop       lop_hoc        @relation(fields: [lop_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  giai_doan giai_doan_khoa @relation(fields: [giai_doan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  // T12 (mo-rong-nls-an-giang.md, 2026-09-30): điểm danh của học viên tại
  // buổi này, nhập qua import diem_danh.
  diem_danh diem_danh[]

  @@unique([lop_id, giai_doan_id, buoi_so], map: "uq_lich_hoc_lop_giai_doan_buoi")
  @@index([lop_id], map: "idx_lich_hoc_lop")
  @@index([giai_doan_id], map: "idx_lich_hoc_giai_doan")
}

model lop_hoc_nhan_su {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lop_id        String              @db.Uuid
  ho_ten        String              @db.VarChar(255)
  vai_tro       vai_tro_nhan_su_lop
  so_dien_thoai String?             @db.VarChar(20)

  lop lop_hoc @relation(fields: [lop_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lop_id], map: "idx_nhan_su_lop")
}

model dang_ky_hoc {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hoc_vien_id     String             @db.Uuid
  khoa_id         String             @db.Uuid
  // Phân lớp theo giai đoạn (spec 2026-10-02): lớp gán qua phan_lop_giai_doan
  // (1 lớp mỗi giai đoạn); bảng cũ 1 lớp mỗi loại đã drop ở migration
  // 20261002100000.
  ngay_dang_ky    DateTime           @default(dbgenerated("CURRENT_DATE")) @db.Date
  trang_thai      trang_thai_dang_ky @default(cho_duyet)
  ket_qua         ket_qua_hoc?
  ngay_hoan_thanh DateTime?          @db.Date
  // T5 (mo-rong-nls-an-giang.md, 2026-09-29): import ket_qua_danh_gia ghi đè
  // đúng cột theo cột "loai" (dau_vao|dau_ra) của dòng import.
  muc_dau_vao     muc_nang_luc?
  muc_dau_ra      muc_nang_luc?
  // QĐ10: cụm học viên (nhóm Zalo hỗ trợ) — gán trực tiếp học viên, không
  // qua lớp nào. NULL = chưa gán cụm.
  cum_id          String?            @db.Uuid

  hoc_vien hoc_vien       @relation(fields: [hoc_vien_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  khoa     khoa_boi_duong @relation(fields: [khoa_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cum      cum_hoc_vien?  @relation(fields: [cum_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  phan_lop_giai_doan phan_lop_giai_doan[]
  // T12 (mo-rong-nls-an-giang.md, 2026-09-30): điểm danh từng buổi + tiến độ
  // từng giai đoạn của đăng ký học này, nhập qua import diem_danh/
  // ket_qua_giai_doan.
  diem_danh          diem_danh[]
  ket_qua_giai_doan  ket_qua_giai_doan[]

  @@unique([hoc_vien_id, khoa_id], map: "uq_dang_ky_hoc_vien_khoa")
  @@index([hoc_vien_id], map: "idx_dang_ky_hoc_vien")
  @@index([khoa_id], map: "idx_dang_ky_khoa")
  @@index([cum_id], map: "idx_dang_ky_cum")
}

// Phân lớp theo giai đoạn (spec 2026-10-02-phan-lop-theo-giai-doan): mỗi
// (đăng ký học, giai đoạn) tối đa 1 lớp — thay thế bảng cũ (1 lớp
// mỗi loại). Bất biến cùng khoa_id kiểm ở KhoaBoiDuongService.
model phan_lop_giai_doan {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dang_ky_hoc_id String   @db.Uuid
  giai_doan_id   String   @db.Uuid
  lop_id         String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  dang_ky_hoc dang_ky_hoc    @relation(fields: [dang_ky_hoc_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  giai_doan   giai_doan_khoa @relation(fields: [giai_doan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lop         lop_hoc        @relation(fields: [lop_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([dang_ky_hoc_id, giai_doan_id], map: "uq_phan_lop_giai_doan")
  @@index([lop_id], map: "idx_phan_lop_giai_doan_lop")
  @@index([giai_doan_id], map: "idx_phan_lop_giai_doan_giai_doan")
}

// T12 (mo-rong-nls-an-giang.md, 2026-09-30): điểm danh nhập qua IMPORT EXCEL
// (không có giao diện chấm tay từng buổi, xem KhoaBoiDuongService.
// resolveDiemDanhRow/commitDiemDanh, gọi từ ImportService) — mỗi dòng = điểm
// danh của 1 học viên (dang_ky_hoc) tại 1 buổi học (lich_hoc_lop) cụ thể.
// UNIQUE (dang_ky_hoc_id, lich_hoc_id) — chạy lại file import ghi đè
// (upsert), không cộng dồn.
model diem_danh {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dang_ky_hoc_id  String               @db.Uuid
  lich_hoc_id     String               @db.Uuid
  trang_thai      trang_thai_diem_danh
  nguon           nguon_diem_danh
  ghi_chu         String?
  nguon_import_id String?              @db.Uuid
  cap_nhat_luc    DateTime             @default(now()) @db.Timestamptz(6)

  dang_ky_hoc  dang_ky_hoc     @relation(fields: [dang_ky_hoc_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lich_hoc     lich_hoc_lop    @relation(fields: [lich_hoc_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nguon_import nhat_ky_import? @relation(fields: [nguon_import_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([dang_ky_hoc_id, lich_hoc_id], map: "uq_diem_danh")
  @@index([lich_hoc_id], map: "idx_diem_danh_lich_hoc")
}

// T12 (mo-rong-nls-an-giang.md, 2026-09-30): kết quả/tiến độ theo từng giai
// đoạn của khóa (vd tiến độ VLE, điểm đánh giá giai đoạn) — nhập qua import
// ket_qua_giai_doan (KhoaBoiDuongService.resolveKetQuaGiaiDoanRow/
// commitKetQuaGiaiDoan). UNIQUE (dang_ky_hoc_id, giai_doan_id) — chạy lại
// file ghi đè. ty_le_hoan_thanh giới hạn 0-100 — CHECK constraint không
// biểu diễn được bằng Prisma DSL (xem comment đầu file), thêm bằng raw SQL
// nối vào migration.
model ket_qua_giai_doan {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dang_ky_hoc_id   String   @db.Uuid
  giai_doan_id     String   @db.Uuid
  ty_le_hoan_thanh Decimal? @db.Decimal(5, 2)
  diem             Decimal? @db.Decimal(5, 2)
  ghi_chu          String?
  nguon_import_id  String?  @db.Uuid
  cap_nhat_luc     DateTime @default(now()) @db.Timestamptz(6)

  dang_ky_hoc  dang_ky_hoc     @relation(fields: [dang_ky_hoc_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  giai_doan    giai_doan_khoa  @relation(fields: [giai_doan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  nguon_import nhat_ky_import? @relation(fields: [nguon_import_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([dang_ky_hoc_id, giai_doan_id], map: "uq_ket_qua_giai_doan")
  @@index([giai_doan_id], map: "idx_ket_qua_giai_doan_giai_doan")
}

// =====================================================================
// PHẦN 4 — THÔNG BÁO
// =====================================================================

// chk_thong_bao_loi (trang_thai='that_bai' => loi NOT NULL) không biểu diễn
// được bằng Prisma DSL — thêm bằng raw SQL nối vào migration này, cùng cách
// làm với các CHECK constraint khác trong migration khởi tạo (xem comment ở
// đầu file).
model nhat_ky_thong_bao {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loai_su_kien     loai_su_kien_thong_bao
  hoc_vien_id      String?                  @db.Uuid
  email_nguoi_nhan String                   @db.VarChar(255)
  tieu_de          String                   @db.VarChar(255)
  gui_luc          DateTime                 @default(now()) @db.Timestamptz(6)
  trang_thai       trang_thai_gui_thong_bao
  loi              String?

  hoc_vien hoc_vien? @relation(fields: [hoc_vien_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hoc_vien_id], map: "idx_thong_bao_hoc_vien")
  @@index([loai_su_kien], map: "idx_thong_bao_loai_su_kien")
  @@index([gui_luc], map: "idx_thong_bao_gui_luc")
}

// M9 (2026-10-01): hàng đợi gửi email hàng loạt (5 sự kiện làn "hàng loạt" —
// xem comment đầu thong-bao.service.ts) — HangDoiEmailProcessor (cron mỗi
// phút) rút tối đa 20 dòng cho_gui/lượt theo FIFO (created_at tăng dần),
// giới hạn thêm bởi EMAIL_DAILY_LIMIT/ngày (giờ Việt Nam) để không vượt hạn
// mức SMTP của Google Workspace. Làn "ưu tiên cao" (guiXacMinhEmail/
// guiDatLaiMatKhau) KHÔNG đi qua bảng này — gửi ngay, chỉ ghi nhat_ky_
// thong_bao để tính vào hạn mức.
model hang_doi_email {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  loai_su_kien     loai_su_kien_thong_bao
  hoc_vien_id      String?                   @db.Uuid
  email_nguoi_nhan String                    @db.VarChar(255)
  tieu_de          String                    @db.VarChar(255)
  noi_dung_html    String                    @db.Text
  trang_thai       trang_thai_hang_doi_email @default(cho_gui)
  so_lan_thu       Int                       @default(0)
  loi              String?
  created_at       DateTime                  @default(now()) @db.Timestamptz(6)
  gui_luc          DateTime?                 @db.Timestamptz(6)

  hoc_vien hoc_vien? @relation(fields: [hoc_vien_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([trang_thai, created_at], map: "idx_hang_doi_email_trang_thai_created_at")
  @@index([hoc_vien_id], map: "idx_hang_doi_email_hoc_vien")
}

// =====================================================================
// PHẦN 5 — YÊU CẦU HỖ TRỢ (M8)
// =====================================================================

model loai_van_de_ho_tro {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ten            String            @db.VarChar(255)
  noi_dung_goi_y String            @db.Text
  trang_thai     trang_thai_active @default(active)
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  updated_at     DateTime          @default(now()) @db.Timestamptz(6)

  yeu_cau yeu_cau_ho_tro[]

  @@unique([ten], map: "uq_loai_van_de_ho_tro_ten")
}

model yeu_cau_ho_tro {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hoc_vien_id        String                    @db.Uuid
  loai_van_de_id     String                    @db.Uuid
  noi_dung_hoi       String                    @db.Text
  noi_dung_tra_loi   String?                   @db.Text
  trang_thai         trang_thai_yeu_cau_ho_tro @default(cho_xu_ly)
  danh_gia           danh_gia_yeu_cau_ho_tro?
  tra_loi_boi        String?                   @db.Uuid
  thoi_gian_tao      DateTime                  @default(now()) @db.Timestamptz(6)
  thoi_gian_phan_hoi DateTime?                 @db.Timestamptz(6)
  thoi_gian_dong     DateTime?                 @db.Timestamptz(6)

  hoc_vien         hoc_vien           @relation(fields: [hoc_vien_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loai_van_de      loai_van_de_ho_tro @relation(fields: [loai_van_de_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tra_loi_boi_user nguoi_dung?        @relation("yeu_cau_ho_tro_tra_loi_boi", fields: [tra_loi_boi], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([trang_thai], map: "idx_yeu_cau_ho_tro_trang_thai")
  @@index([hoc_vien_id], map: "idx_yeu_cau_ho_tro_hoc_vien")
  @@index([loai_van_de_id, trang_thai], map: "idx_yeu_cau_ho_tro_loai_trang_thai")
}

/// Cấu hình vận hành dạng khóa-giá trị (2026-10-02). Hiện có 1 khóa
/// 'khao_sat_dau_vao' — chế độ triển khai cho học viên + danh sách phiếu khảo
/// sát ở trang chủ, do quan_tri sửa tại /admin/cau-hinh-khao-sat. Shape gia_tri
/// do DTO tầng ứng dụng kiểm soát (cau-hinh-khao-sat.dto.ts).
model cau_hinh_he_thong {
  khoa         String   @id @db.VarChar(100)
  gia_tri      Json
  cap_nhat_luc DateTime @default(now()) @db.Timestamptz(6)
  cap_nhat_boi String?  @db.Uuid
}
