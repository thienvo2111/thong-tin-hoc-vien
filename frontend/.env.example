# Sao chép thành .env.local khi phát triển
VITE_API_BASE_URL=http://localhost:3000
VITE_SITE_URL=https://hocvien.example.edu.vn

# Cổng đơn vị (issue #55, ADR 0015) — để trống/không khai báo = chỉ có trang NLS như cũ.
# Production: hostname tên miền Cổng đơn vị + URL gốc; VITE_API_BASE_URL nên để rỗng để API đi cùng origin.
# Dev: mở http://donvi.localhost:5173 để thử Cổng đơn vị, http://localhost:5173 vẫn là trang NLS.
# VITE_CONG_DON_VI_HOSTNAME=donvi.localhost
# VITE_CONG_DON_VI_URL=http://donvi.localhost:5173
